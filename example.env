# Environment variables for Youtube Made Simple

# Ollama host configuration (REQUIRED)
# Replace with the actual host and port where your Ollama server is running.
# If running Docker on Linux, this might be http://localhost:11434
# If running Docker Desktop (Mac/Win), use http://host.docker.internal:11434
OLLAMA_HOST=http://host.docker.internal:11434

# Ollama context window size (OPTIONAL)
# Sets the context window size (num_ctx) for Ollama calls.
# The default value used in the code if this is not set is 2k.
# Adjust based on your model's capabilities and system resources.
# OLLAMA_NUM_CTX=2048

# Ollama model name (OPTIONAL)
# Specifies the Ollama model to use for processing.
# The default value used in the code if this is not set is 'qwen3:30b-a3b'.
# Make sure the model specified here is available in your Ollama instance.
# OLLAMA_MODEL=llama3:latest
OLLAMA_MODEL=qwen3:30b-a3b

OLLAMA_NUM_CTX=2048
